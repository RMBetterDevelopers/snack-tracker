# Copy to .env and fill in. Never commit .env.

# --- Local Postgres (docker-compose.yml reads these) ---
POSTGRES_USER=snack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=snack_tracker

# --- Prisma ---
# Dev database
DATABASE_URL=postgresql://snack:change-me@localhost:5432/snack_tracker
# Separate test database for Vitest (must differ from DATABASE_URL; it is truncated between tests)
TEST_DATABASE_URL=postgresql://snack:change-me@localhost:5432/snack_tracker_test

# --- Better Auth ---
# Generate with: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Seeded test user (used by prisma/seed.ts and Playwright). Do not set in production. ---
TEST_USER_EMAIL=test.user@example.com
TEST_USER_PASSWORD=replace-with-a-test-password
